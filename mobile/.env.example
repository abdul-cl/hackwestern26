# Copy this to .env and point it at the backend.
# Leave it blank to use the defaults: 10.0.2.2:8000 on the Android emulator, localhost:8000 on web.
# For a real phone (Expo Go) use a URL it can reach, like the cloudflared tunnel or the Railway URL.
EXPO_PUBLIC_API_URL=
# Only if the backend has CARESCOUT_API_KEY set. Anything EXPO_PUBLIC_ ends up inside the app, so no secret keys here.
EXPO_PUBLIC_API_KEY=
