# Copy to .env.local for local overrides. On Cloudflare, set them as build variables:
# Workers & Pages -> the Worker -> Settings -> Build -> Variables and secrets (see DEPLOY.md).
VITE_API_URL=http://localhost:8000
# Only if the backend sets CARESCOUT_API_KEY. Anything starting with VITE_ is visible in the public site's code.
VITE_API_KEY=
